# n8n Connection Configuration
# Copy this to .env and fill in your values

# Mode: "cloud" or "self-hosted"
N8N_MODE=self-hosted

# Base URL of your n8n instance (no trailing slash)
# Cloud: https://your-instance.app.n8n.cloud
# Self-hosted: http://localhost:5678
N8N_BASE_URL=http://localhost:5678

# Your n8n API key (Settings > n8n API > Create an API Key)
N8N_API_KEY=n8n_api_xxxxxxxxxxxxx
